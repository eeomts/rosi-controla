; Copie para config.ini e ajuste.
; user e pass ficam ofuscados: Cubo\Tools\Str::cuboEncode('valor') gera, o Db decodifica.

[cubo]
location = local
host.local = http://localhost/
host.wan = https://SEU-DOMINIO/
enviroment = development
servidor = LOCAL
versao = V1
table_prefix =
database_prefix =
path_prefix =
redir =
url_login =

[database.local]
; dbtype = mariadb usa o driver nativo do illuminate 11 (MariaDbConnector)
; charset/collation sao opcionais; sem eles o Db assume utf8mb4
dbtype = mariadb
host = localhost
port = 3306
db = 
user = "Y205dmRBPT0="
pass = ""

[database.wan]
; dbtype = mariadb usa o driver nativo do illuminate 11 (MariaDbConnector)
; charset/collation sao opcionais; sem eles o Db assume utf8mb4
dbtype = mariadb
host = 127.0.0.1
port = 3306
db = 
user = ""
pass = ""
