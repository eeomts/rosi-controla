{
    "name": "rosi/controla",
    "description": "Controla - controle de estoque e financeiro (Cubo Framework)",
    "require": {
        "php": ">=8.2",
        "illuminate/database": "^11.0",
        "mpdf/mpdf": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Cubo\\": "app/Cubo2/src/",
            "PHPMailer\\PHPMailer\\": "app/Cubo2/PHPMailer/src/",
            "Controla\\": "app/Controla/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cubo\\Tests\\": "app/Cubo2/tests/",
            "Controla\\Tests\\": "app/Controla/tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}
