# Copie para a raiz como .env na VPS e troque as senhas. O .env NAO vai para o git.
#
#   cp deploy/env.example .env
#
# Estas credenciais sao as do container do MariaDB. As mesmas precisam entrar no
# deploy/config.ini -- la elas vao ofuscadas com o cuboEncode:
#   php deploy/cubo-encode.php "a-senha"

DB_NAME=rosi_controla
DB_USER=controla
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-tambem

PORTA_LOCAL=8001
