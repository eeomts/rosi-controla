# Unidade disparada pelo controla-watchdog.timer. O "up -d" e idempotente:
# com tudo de pe ele nao faz nada; com algo derrubado, sobe de novo.

[Unit]
Description=Sobe o Controla se algum container tiver caido
Requires=docker.service
After=docker.service

[Service]
Type=oneshot

User=SEU-USUARIO
WorkingDirectory=/home/SEU-USUARIO/controla

ExecStart=/usr/bin/docker compose up -d --remove-orphans
