# Watchdog: sobe o compose no boot e o mantem de pe.
#
#   sudo cp deploy/controla.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/controla.service   # ajuste User e WorkingDirectory
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now controla
#
# Por que existe: restart: unless-stopped nao traz o container de volta depois de
# um "docker stop" explicito, nem depois de um prune. Isto traz.

[Unit]
Description=Controla (docker compose)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

User=SEU-USUARIO
WorkingDirectory=/home/SEU-USUARIO/controla

ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose stop

# reconcilia sozinho: se derrubarem os containers, o timer volta a subir
ExecReload=/usr/bin/docker compose up -d

TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
