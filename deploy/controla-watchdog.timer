# Reconciliador: de 5 em 5 minutos garante que os containers estao de pe.
#
#   sudo cp deploy/controla-watchdog.timer deploy/controla-watchdog.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now controla-watchdog.timer
#   systemctl list-timers controla-watchdog.timer

[Unit]
Description=Verifica de tempos em tempos se o Controla esta de pe

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
