; Copie para deploy/config.ini na VPS -- o compose monta este arquivo dentro do
; container em app/Controla/config/config.ini (read-only).
;
;   cp deploy/config.ini.example deploy/config.ini
;
; O .gitignore ja ignora qualquer config.ini, entao ele nao sobe para o git.

[cubo]
location = wan

host.local = http://localhost/
; ARMADILHA: tem de ser o dominio real COM a barra final. O Router monta a rota
; com SERVER_NAME + REQUEST_URI e corta este valor sem o protocolo; se nao casar,
; a URL inteira vira segmento e toda rota quebra.
host.wan = https://controla.SEU-DOMINIO.com/

; qualquer coisa != development registra o ErrorHandler em vez de mostrar a
; excecao na tela
enviroment = production
servidor = VPS
versao = V1

table_prefix =
database_prefix =
path_prefix =
redir =
url_login =

[database.local]
dbtype = mariadb
host = localhost
port = 3306
db = rosi_controla
user = ""
pass = ""

[database.wan]
dbtype = mariadb
; "db" e o nome do servico no docker-compose.yml, resolvido pela rede do compose
host = db
port = 3306
db = rosi_controla
; ofuscados: php deploy/cubo-encode.php "valor"
user = ""
pass = ""
charset = utf8mb4
collation = utf8mb4_unicode_ci
